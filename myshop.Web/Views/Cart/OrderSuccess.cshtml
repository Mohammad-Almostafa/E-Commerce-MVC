@model int

@{
    ViewBag.PageTitle = "Order Confirmation";
}

<div class="container my-5 text-center">
    <div class="card shadow-lg p-4 mx-auto" style="max-width: 600px;">
        <div class="card-body">
            <!-- Icon -->
            <div class="mb-4 text-success">
                <i class="fa-solid fa-circle-check fa-5x"></i>
            </div>

            <!-- Title -->
            <h1 class="card-title text-success fw-bold mb-3">Thank You for Your Order!</h1>
            <p class="text-muted fs-5">
                Your order has been placed successfully and is now being processed.
            </p>

            <!-- Order ID Badge -->
            <div class="alert alert-light border my-4 p-3">
                <span class="text-secondary d-block mb-1">Your Order Number</span>
                <span class="fs-3 fw-bold text-primary">#@Model</span>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mt-4">
                <a asp-controller="Order" asp-action="Details" asp-route-id="@Model" class="btn btn-outline-primary btn-lg">
                    <i class="fa-solid fa-receipt me-1"></i> View Order Details
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="fa-solid fa-bag-shopping me-1"></i> Continue Shopping
                </a>
            </div>
        </div>
    </div>
</div>