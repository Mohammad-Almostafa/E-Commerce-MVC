@using myshop.Business.DTOs
@model IEnumerable<ProductListDTO>

@{
    ViewBag.PageTitle = "Products Management";
    ViewBag.CardTitle = "View Products";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

<style>
    .custom-card {
        background: rgba(255,255,255,.75);
        backdrop-filter: blur(12px);
        border-radius: 18px;
        border: 1px solid rgba(160,173,186,.35);
        box-shadow: 0 15px 35px rgba(0,0,0,.12);
        padding: 28px;
        animation: fadeIn .4s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .custom-card-title {
        background: linear-gradient(135deg,#1e3a8a,#3b82f6);
        padding: 18px;
        border-radius: 14px;
        margin-bottom: 22px;
        text-align: center;
        color: white;
        font-weight: 700;
        letter-spacing: .6px;
        font-size: 22px;
        box-shadow: 0 4px 20px rgba(30,58,138,.35);
    }

    .top-btn {
        margin-bottom: 18px;
        text-align: right;
    }

    .btn-primary {
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 600;
        border: none;
        background: linear-gradient(135deg,#1e40af,#2563eb);
        color: white;
        box-shadow: 0 6px 20px rgba(37,99,235,.35);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg,#1e3a8a,#1d4ed8);
            transform: translateY(-2px);
        }

    #mytable thead th {
        background: #1e40af !important;
        color: white !important;
        padding: 14px !important;
        border: none !important;
    }

    #mytable tbody td {
        background: white !important;
        padding: 14px !important;
        color: #1e3a8a;
        border-bottom: 1px solid #e3e8ef !important;
    }

    #mytable tbody tr:hover td {
        background: #ebf2ff !important;
    }

    .action-btn {
        padding: 7px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
    }

    .btn-success {
        background: #16a34a;
        color: white;
        border: none;
    }

    .btn-danger {
        background: #dc2626;
        color: white;
        border: none;
    }
</style>

<div class="custom-card">

    <div class="custom-card-title">
        <i class="fa-solid fa-box-open me-2"></i>
        Products List
    </div>

    <div class="top-btn">
        <a asp-controller="Product"
           asp-action="Create"
           class="btn btn-primary">
            <i class="fa-solid fa-circle-plus me-1"></i>
            Create Product
        </a>
    </div>

    <table id="mytable" class="display table-hover" width="100%">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Category</th>
                <th>CreatedAt</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@Html.Raw(item.Description)</td>
                    <td>@item.Price</td>
                    <td>@item.CategoryName</td>
                    <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        <a class="btn btn-success me-1"
                            asp-area="Admin"
                            asp-controller="Product"
                            asp-action="Edit"
                            asp-route-id="@item.Id">
                            <i class="fa-solid fa-pen-to-square"></i> Edit
                        </a>
                        <form asp-controller="Product" asp-action="DeleteProduct" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently delete this product?');">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-danger">
                                <i class="fa-solid fa-trash"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

@section Scripts {
    <script src="~/js/products.js"></script>
}