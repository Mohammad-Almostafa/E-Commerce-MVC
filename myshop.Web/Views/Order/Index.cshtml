@model IEnumerable<myshop.DataAccess.Entities.Models.OrderHeader>

@{
    ViewBag.PageTitle = "My Orders";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fa-solid fa-box-archive me-2"></i> My Orders</h2>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
            <i class="fa-solid fa-bag-shopping me-1"></i> Continue Shopping
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center p-5 shadow-sm">
            <i class="fa-solid fa-circle-info fa-3x mb-3 text-info"></i>
            <h4>You haven't placed any orders yet!</h4>
            <p class="text-muted">Browse our products and make your first order.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Start Shopping</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle text-center mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Order #</th>
                                <th>Date</th>
                                <th>Recipient</th>
                                <th>Phone</th>
                                <th>Total Price</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td class="fw-bold">#@order.Id</td>
                                    <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@order.Name</td>
                                    <td>@order.PhoneNumber</td>
                                    <td class="fw-bold text-success">$@order.TotalPrice.ToString("F2")</td>
                                    <td>
                                        <span class="badge bg-success">@order.OrderStatus</span>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-primary">
                                            <i class="fa-solid fa-eye me-1"></i> View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>